{% if o.expiry %}


def test_link_expires(service, clock):
    link = service.create_link("https://example.com", expires_in_seconds=3600)
    clock.advance(minutes=59)
    assert service.resolve(link.code) == "https://example.com"
    clock.advance(minutes=1)
    with pytest.raises(Gone):
        service.resolve(link.code)


@pytest.mark.parametrize("ttl", [0, 59, -5, "60", 1.5, True, 10**10])
def test_invalid_ttl_is_rejected(service, ttl):
    with pytest.raises(InvalidRequest):
        service.create_link("https://example.com", expires_in_seconds=ttl)
