def test_custom_alias_and_conflict(service):
    link = service.create_link("https://example.com", custom_alias="promo")
    assert link.code == "promo" and link.is_custom
    with pytest.raises(Conflict):
        service.create_link("https://other.example", custom_alias="promo")
