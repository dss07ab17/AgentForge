import pytest

from shortener.errors import {% if o.custom_alias %}Conflict, {% endif %}{% if o.expiry %}Gone, {% endif %}InvalidRequest, NotFound, Unavailable
from shortener.service import ShortenerService


class ScriptedCodes:
    """Code generator that returns a fixed sequence (to force collisions)."""

    def __init__(self, *codes):
        self.codes = list(codes)

    def generate(self):
        return self.codes.pop(0)


def test_create_and_resolve(service):
    link = service.create_link("https://example.com/page")
    assert len(link.code) == 7
    assert service.resolve(link.code) == "https://example.com/page"


def test_invalid_url_is_rejected(service):
    with pytest.raises(InvalidRequest):
        service.create_link("not a url")


def test_unknown_code_raises_not_found(service):
    with pytest.raises(NotFound):
        service.resolve("missing")


def test_collision_is_retried_with_a_new_code(repo, settings, recorder, clock):
    svc = ShortenerService(repo, settings, recorder=recorder, clock=clock, codegen=ScriptedCodes("AAAAAAA", "AAAAAAA", "BBBBBBB"))
    first = svc.create_link("https://one.example")
    second = svc.create_link("https://two.example")
    assert (first.code, second.code) == ("AAAAAAA", "BBBBBBB")
    assert svc.resolve("AAAAAAA") == "https://one.example"  # existing link was NOT overwritten


def test_gives_up_after_repeated_collisions(repo, settings, recorder, clock):
    svc = ShortenerService(repo, settings, recorder=recorder, clock=clock, codegen=ScriptedCodes(*["CCCCCCC"] * 6))
    svc.create_link("https://one.example")
    with pytest.raises(Unavailable):
        svc.create_link("https://two.example")


def test_delete_removes_link_and_invalidates_cache(service):
    link = service.create_link("https://example.com")
    service.resolve(link.code)  # warms the cache
    service.delete_link(link.code)
    with pytest.raises(NotFound):
        service.resolve(link.code)
    with pytest.raises(NotFound):
        service.delete_link(link.code)
