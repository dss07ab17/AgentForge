 def connect(path="linkshort.db"):
     conn = sqlite3.connect(path, check_same_thread=False)
     conn.executescript(SCHEMA)
+    _migrate(conn)
     return conn
+
+
+def _migrate(conn):
+    """Forward-only, idempotent migration for databases created by v1."""
+    columns = {row[1] for row in conn.execute("PRAGMA table_info(links)")}
+    if "expires_at" not in columns:
+        conn.execute("ALTER TABLE links ADD COLUMN expires_at REAL")
+        conn.commit()
