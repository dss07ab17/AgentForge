-    url = store.get_url(conn, code)
-    if url is None:
+class CodeSpaceExhausted(Exception):
+    """Could not find a free code after MAX_CODE_ATTEMPTS tries."""
+
+
+def shorten(conn, url, code_factory=new_code, ttl_seconds=None, clock=None):
+    if not isinstance(url, str) or not url.startswith(("http://", "https://")):
+        raise ValueError("url must start with http:// or https://")
+    expires_at = None
+    if ttl_seconds is not None:
+        if isinstance(ttl_seconds, bool) or not isinstance(ttl_seconds, int):
+            raise ValueError("ttl_seconds must be an integer")
+        if not MIN_TTL_SECONDS <= ttl_seconds <= MAX_TTL_SECONDS:
+            raise ValueError(f"ttl_seconds must be between {MIN_TTL_SECONDS} and {MAX_TTL_SECONDS}")
+        expires_at = (clock or time.time)() + ttl_seconds
+    for _ in range(MAX_CODE_ATTEMPTS):
+        code = code_factory()
+        try:
+            store.save_link(conn, code, url, expires_at)
+            return code
+        except store.DuplicateCode:
+            continue  # collision: never overwrite, try a fresh code
+    raise CodeSpaceExhausted("could not allocate a unique code")
+
+
+def resolve(conn, code, clock=None):
+    link = store.get_link(conn, code)
+    if link is None:
         raise LinkNotFound(code)
+    url, expires_at = link
+    if expires_at is not None and (clock or time.time)() >= expires_at:
+        raise LinkExpired(code)
     return url
