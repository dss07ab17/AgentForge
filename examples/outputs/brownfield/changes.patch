 """Business logic for shortening and resolving links."""
+import time
+
 from app import store
 from app.codes import new_code
+
+
+MAX_CODE_ATTEMPTS = 10
+MIN_TTL_SECONDS = 1
+MAX_TTL_SECONDS = 10 * 365 * 24 * 3600
 
 
 class LinkNotFound(Exception):
